<?xml version="1.0" encoding="utf-8"?>
<!-- Calculator's launcher glyph, the user's picture made the YAZ way (Modules/icons/calculator):
     the plate and its keys a grey the wallpaper's accent multiplies, their white light
     untinted over it, the four signs on top in ivory. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <bitmap
            android:src="@drawable/keys_body"
            android:tint="@color/ic_launcher_disc"
            android:tintMode="multiply" />
    </item>
    <item android:drawable="@drawable/keys_shine" />
    <item android:drawable="@drawable/keys_signs" />
</layer-list>
